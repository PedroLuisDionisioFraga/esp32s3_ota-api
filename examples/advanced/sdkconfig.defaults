# Default sdkconfig parameters to use the OTA
# partition table layout, with a 4MB flash size
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_TWO_OTA_LARGE=y

# Boot a new image in PENDING_VERIFY state so the console can confirm it or
# let it roll back. Without this there is no trial run to confirm.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Required by ota_api_config_t.partial_download: fetch the image over several
# ranged HTTP requests instead of one long transfer.
CONFIG_ESP_HTTPS_OTA_ENABLE_PARTIAL_DOWNLOAD=y

# Certificate bundle configuration: trust the certificate generated by
# examples/common/ota_server.py alongside the default public roots
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH="../common/certs/ca_cert.pem"
